generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") 
}

model UserCache {
  userId    String   @id
  email     String
  updatedAt DateTime @updatedAt
}

model OrgCache {
  organizationId    String   @id
  organizationName     String
  tier  String
  managerId String
  updatedAt DateTime @updatedAt
}