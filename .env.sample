# -------------------------
# DATABASE CONFIGURATION
# -------------------------
DATABASE_URL="postgresql://admin:StrongPass123@notification-postgres:5432/notification_db?schema=public"

# -------------------------
# KAFKA CONFIGURATION
# -------------------------
KAFKA_BROKER="host.docker.internal:9092"
KAFKA_GROUP_ID="notification-group"
KAFKA_TOPIC_READ_TICKET="ticket-management-events"
KAFKA_TOPIC_READ_ORG="organization-access-events"
KAFKA_TOPIC_WRITE="notification-events"
KAFKA_TOPIC_READ_BILLING="billing-events"

# -------------------------
# EMAIL SERVICE (MAILTRAP)
